# Copy to .env.local and fill in. Keys stay on the server; the browser never sees them.
# Put AI_API_KEY in .env.development.local instead if you deploy to Cloudflare from this
# machine: a Cloudflare build copies .env.local into the Worker. On Cloudflare the key is a
# secret (npx wrangler secret put AI_API_KEY). See "Deploy to Cloudflare" in the README.

# "openrouter", "openai-compatible" (any other Chat Completions-style API),
# or "mock" (canned output, no key needed)
AI_PROVIDER=openrouter
# Your provider key goes here, not on the AI_PROVIDER line
AI_API_KEY=
# Exact model id as your provider names it
AI_MODEL=openai/gpt-6-luna
# Optional. Only needed for "openai-compatible" endpoints other than api.openai.com
AI_BASE_URL=
# Optional. For models that think before answering: "low" makes plot suggestions
# come back much faster. Leave empty for the model's default.
AI_REASONING_EFFORT=low
