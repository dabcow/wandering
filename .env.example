# Copy to .env.local and fill in. Keys stay on the server; the browser never sees them.

# "openai-compatible" (any Chat Completions-style API) or "mock" (canned output, no key needed)
AI_PROVIDER=openai-compatible
AI_API_KEY=
# Exact model id as your provider names it
AI_MODEL=
# Optional. Defaults to https://api.openai.com/v1
AI_BASE_URL=
